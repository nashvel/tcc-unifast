APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Allowed CORS origins for the Vue SPA (config/cors.php). Comma-separated,
# scheme + host (+ port), no trailing slash.
# Production example: FRONTEND_URL=https://tcc-unifast.vercel.app
FRONTEND_URL=http://localhost:5173

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# For live notifications, install Laravel Reverb (`php artisan install:broadcasting`)
# then set BROADCAST_CONNECTION=reverb and fill REVERB_* / VITE_REVERB_* below.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# For local demo, keep MAIL_MAILER=log. For real activation emails, set MAIL_MAILER=smtp
# and fill the SMTP placeholders below.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@tcc-unifast.local"
MAIL_FROM_NAME="TCC UniFAST TES"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# TCC UniFAST -> n8n synchronization
TCC_UNIFAST_N8N_WEBHOOK_URL=
TCC_UNIFAST_N8N_WEBHOOK_HEADER=X-TCC-UniFAST-Key
TCC_UNIFAST_N8N_WEBHOOK_SECRET=
TCC_UNIFAST_SYNC_ENDPOINT_SECRET=
TCC_UNIFAST_N8N_TIMEOUT=15
TCC_UNIFAST_STUDENT_TABLE=students

OCR_SERVICE_URL=http://127.0.0.1:8001
OCR_SERVICE_TIMEOUT=120
OCR_SPACE_API_KEY=
OCR_SPACE_TIMEOUT=60
TCC_REGISTRAR_DOMAINS=registrar.tcc.edu.ph,sis.tcc.edu.ph,tcc.edu.ph
VITE_TCC_REGISTRAR_DOMAINS=registrar.tcc.edu.ph,sis.tcc.edu.ph,tcc.edu.ph
AUTHENTICITY_SERVICE_URL=
IDENTITY_FACE_MATCH_THRESHOLD=0.5
# Optional path to Python for gradeslip QR (defaults to python/.venv then `python`)
GRADESLIP_QR_PYTHON=
GRADESLIP_QR_TIMEOUT=60

# Face verification provider placeholders.
# Supported local mode for demos: FACE_API_PROVIDER=mock
# For a real provider, set FACE_API_PROVIDER=http and provide the endpoint/key.
FACE_API_PROVIDER=mock
FACE_API_URL=https://face-provider.example.com/api/verify
FACE_API_KEY=your_face_api_key
FACE_API_TIMEOUT=30
FACE_API_MATCH_THRESHOLD=85
