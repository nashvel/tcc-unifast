# Root Docker Compose local defaults.
#
# Copy to .env only when you want to override compose.yml defaults:
#   cp .env.example .env

APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=5173
BACKEND_PORT=8000

DB_DATABASE=tcc_unifast
DB_USERNAME=tcc_unifast
DB_PASSWORD=tcc_unifast
MYSQL_ROOT_PASSWORD=tcc_unifast_root
MYSQL_PORT=3307
REDIS_PORT=6380

OCR_SERVICE_PORT=8001
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

TCC_UNIFAST_N8N_WEBHOOK_URL=http://n8n:5678/webhook/tcc-unifast/social-posts/facebook
TCC_UNIFAST_N8N_WEBHOOK_SECRET=
TCC_UNIFAST_SYNC_ENDPOINT_SECRET=

# ─── Secrets: generate your own, never copy these blank lines forward ───
#
# APP_KEY signs Laravel's encrypted cookies AND the HMAC signatures on the public
# /api/signed/* file routes, which are the only auth those routes have. A shared or
# leaked key means forgeable document URLs, so every environment needs its own.
#
#   APP_KEY:             docker compose run --rm backend php artisan key:generate --show
#   N8N_ENCRYPTION_KEY:  openssl rand -hex 32
#
# Left blank deliberately. An earlier revision shipped a real key here; it is burned
# (present in git history) and must never be reused.
APP_KEY=
N8N_ENCRYPTION_KEY=
