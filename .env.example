# Root Docker Compose defaults for the supporting services only.
#
# Copy to .env only when you want to override compose.yml defaults:
#   cp .env.example .env

REDIS_PORT=6380

OCR_SERVICE_PORT=8081
OCR_API_KEY=
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
LARAVEL_API_URL=http://host.docker.internal:8000

TCC_UNIFAST_N8N_WEBHOOK_SECRET=
TCC_UNIFAST_SYNC_ENDPOINT_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ─── Secrets: generate your own, never copy these blank lines forward ───
#
# N8N_ENCRYPTION_KEY protects credentials stored by n8n. Generate one with:
#   openssl rand -hex 32
#
N8N_ENCRYPTION_KEY=
