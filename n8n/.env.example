# Local n8n settings for Docker Compose.
#
# Copy this file to .env before running:
#   cp n8n/.env.example n8n/.env

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Manila
TZ=Asia/Manila

# Recommended: set a stable random value before creating credentials.
# Example:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=
LARAVEL_API_URL=http://host.docker.internal:8000

# Redis exposed to the host-run Laravel backend.
REDIS_PORT=6380

# Local OCR service settings.
OCR_SERVICE_PORT=8081
TESSERACT_PSM=6
SAVE_DEBUG_IMAGES=false
OCR_API_KEY=

# Facebook publishing workflow settings.
TCC_UNIFAST_N8N_WEBHOOK_SECRET=
TCC_UNIFAST_SYNC_ENDPOINT_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
