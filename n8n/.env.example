# Local n8n settings for Docker Compose.
#
# Copy this file to .env before running:
#   cp n8n/.env.example n8n/.env

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Manila
TZ=Asia/Manila

# Recommended: set a stable random value before creating credentials.
# Example:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Local OCR service settings.
OCR_SERVICE_PORT=8001
TESSERACT_PSM=6
SAVE_DEBUG_IMAGES=false

# Facebook publishing workflow settings.
TCC_UNIFAST_N8N_WEBHOOK_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
